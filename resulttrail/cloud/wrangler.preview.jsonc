{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "resulttrail-review-preview",
  "workers_dev": true,
  "preview_urls": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "resulttrail-review-preview",
    "database_id": "9d9ecf85-2efc-4160-b237-783e753591de"
  }]
}
